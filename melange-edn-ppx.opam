opam-version: "2.0"
version: "0.5.0"
synopsis: "Compile-time EDN literals for OCaml and Melange"
description:
  "melange-edn-ppx validates EDN literals at compile time and expands them into backend-independent calls to the public melange-edn-core construction API."
maintainer: ["rcmerci <rcmerci@gmail.com>"]
authors: ["rcmerci"]
license: "MIT"
homepage: "https://github.com/RCmerci/melange-edn"
bug-reports: "https://github.com/RCmerci/melange-edn/issues"
depends: [
  "dune" {>= "3.16"}
  "ocaml" {>= "5.2"}
  "melange-edn-core" {= version}
  "ppxlib" {>= "0.36.0"}
  "js_of_ocaml" {with-test & >= "5.7.0"}
  "melange-edn-melange" {with-test & = version}
  "melange" {with-test & >= "5.0.0-52"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/RCmerci/melange-edn.git"
